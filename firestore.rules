rules_version = '2';

// Cinco Conecta — plataforma protegida de Cinco S.A.S.
// "staff" representa a TODOS los empleados con acceso (no solo Talento
// Humano): rol "admin" gestiona vacantes/candidatos/empleados/encuestas/
// comunicados; rol "empleado" tiene acceso regular (reconocer, ver
// comunicados, responder encuestas). "vacantes" y "comunicados"/
// "encuestas" son de lectura para cualquier empleado; "candidatos" y las
// respuestas de encuesta nunca son accesibles directo desde el cliente —
// todo pasa por Cloud Functions con el Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isEmpleado() {
      return isSignedIn() && staffDoc().estado == 'activo';
    }

    function isAdmin() {
      return isEmpleado() && staffDoc().rol == 'admin';
    }

    // Permisos finos otorgables a un empleado sin hacerlo admin completo
    // (ver staff.permisos, gestionado desde actualizarPermisosEmpleado). Un
    // admin siempre tiene los 9, sin necesitar el arreglo poblado.
    function tienePermiso(clave) {
      let perfil = staffDoc();
      return isAdmin() || (('permisos' in perfil) && clave in perfil.permisos);
    }

    match /staff/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isEmpleado();
      allow write: if false;
    }

    match /vacantes/{id} {
      allow read: if true;
      allow write: if tienePermiso('vacantes');
    }

    match /candidatos/{id} {
      allow read, write: if tienePermiso('candidatos');
    }

    match /reconocimientos/{id} {
      allow read: if isEmpleado();
      allow create: if isEmpleado() && request.resource.data.deAutorUid == request.auth.uid;
      // Solo se permite modificar el arreglo de "me gusta" desde el cliente;
      // el resto de campos del reconocimiento son inmutables una vez creado.
      allow update: if isEmpleado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['megusta']);
      allow delete: if isAdmin();
    }

    match /encuestas/{id} {
      allow read: if isEmpleado();
      allow write: if tienePermiso('encuestas');

      // Cada quien puede ver si YA votó esta encuesta (para no mostrarle de
      // nuevo el formulario), pero nunca puede escribir aquí directo — solo
      // la Cloud Function responderEncuesta lo hace, y nadie puede leer el
      // voto de otra persona.
      match /votos/{uid} {
        allow get: if isSignedIn() && request.auth.uid == uid;
        allow list, write: if false;
      }
    }

    match /comunicados/{id} {
      allow read: if isEmpleado();
      allow write: if tienePermiso('comunicados');
    }

    // Las respuestas de encuesta deben quedar anónimas (sin uid) y no se
    // puede confiar en el cliente para impedir el doble voto sin revelar
    // quién respondió — por eso solo se escriben desde la Cloud Function
    // responderEncuesta. El admin sí puede LEERLAS (para ver resultados y
    // promedios), pero como nunca tienen uid, siguen siendo anónimas.
    match /encuestaRespuestas/{id} {
      allow read: if tienePermiso('encuestas');
      allow write: if false;
    }

    // ---- Sistema SGI-HSEQ ----

    // Cualquier empleado ve los incidentes (transparencia de seguridad),
    // pero se crean solo desde la Cloud Function reportarIncidente (para
    // poder subir la foto con el Admin SDK sin abrir Storage al público).
    // Solo el admin los edita/cierra.
    match /incidentes/{id} {
      allow read: if isEmpleado();
      allow create: if false;
      allow update, delete: if tienePermiso('incidentes');
    }

    // El admin crea/borra acciones correctivas; el responsable asignado
    // puede actualizar únicamente su propio avance (estado/evidencia), no
    // reasignarla ni tocar el resto de campos.
    match /accionesCorrectivas/{id} {
      allow read: if isEmpleado();
      allow create, delete: if tienePermiso('accionesCorrectivas');
      allow update: if tienePermiso('accionesCorrectivas')
        || (isEmpleado() && resource.data.responsableUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'evidencia']));
    }

    // El repositorio de documentos lo lee cualquier empleado; se sube solo
    // desde la Cloud Function subirDocumento (admin).
    match /documentos/{id} {
      allow read: if isEmpleado();
      allow write: if false;
    }

    match /auditorias/{id} {
      allow read: if isEmpleado();
      allow write: if tienePermiso('auditorias');
    }

    // Catálogo de nombres de estrategia/subtítulo ya usados en informes de
    // gestión anteriores — solo para autocompletar el formulario de
    // creación (no es dato sensible, pero solo el coordinador lo toca).
    match /configuracion/informesGestion {
      allow read, write: if tienePermiso('informesGestion');
    }

    // Informes de gestión mensuales por contrato (ej. PER-2026-001),
    // compendiados a partir de las "estrategias" que aporta cada
    // responsable. El documento padre (metadatos + estado) solo lo toca
    // quien tiene el permiso 'informesGestion' (coordinador/admin); cada
    // estrategia vive en subcolección — un documento por estrategia, nunca
    // un solo blob compartido — así el guardado de una persona jamás
    // pisa el de otra, y cada quien solo puede escribir en la(s) suya(s).
    match /informesGestion/{informeId} {
      allow read: if isEmpleado();
      allow create, delete: if tienePermiso('informesGestion');
      allow update: if tienePermiso('informesGestion');

      match /estrategias/{estrategiaId} {
        allow read: if isEmpleado();
        allow create, delete: if tienePermiso('informesGestion');
        // El responsable asignado solo puede tocar el contenido/estado de
        // SU estrategia (nunca reasignarla ni editar otra), y solo mientras
        // el informe padre no esté consolidado.
        allow update: if tienePermiso('informesGestion')
          || (isEmpleado()
              && request.auth.uid in resource.data.responsables
              && get(/databases/$(database)/documents/informesGestion/$(informeId)).data.estado != 'consolidado'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contenido', 'estado', 'actualizadoEn', 'actualizadoPor', 'actualizadoPorNombre']));
      }
    }
  }
}
