rules_version = '2';

// Ningún acceso público ni de cliente a Storage: las hojas de vida se
// suben y se leen exclusivamente desde Cloud Functions con el Admin SDK
// (enviarPostulacion / obtenerArchivoBase64), que no están sujetas a estas
// reglas — así los currículums (datos personales) nunca quedan expuestos
// por una URL directa de Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Imágenes de los bloques de contenido de "Informes de Gestión"
    // (web/js/informes-gestion.js) — fotos/gráficas internas del informe,
    // no datos personales como las hojas de vida de arriba. Cualquier
    // persona autenticada del staff puede leer/escribir; el control de
    // QUIÉN puede asociar una imagen a qué estrategia ya lo hace
    // firestore.rules sobre el campo "contenido" de esa estrategia.
    match /informesGestion/{informeId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
